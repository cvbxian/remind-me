# Copy to .env.container and fill in LOCAL values. NEVER commit .env.container.
APP_NAME="Remind Me"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
LOG_CHANNEL=stderr

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=remind_me_container_db
DB_USERNAME=remind_app
DB_PASSWORD=

# Read only by the MySQL image to create the database and the dedicated account
MYSQL_DATABASE=remind_me_container_db
MYSQL_USER=remind_app
MYSQL_PASSWORD=
MYSQL_RANDOM_ROOT_PASSWORD=yes

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Lab 3 seeder (fictional account passwords)
LAB_STUDENT_PASSWORD=
LAB_ADMIN_PASSWORD=